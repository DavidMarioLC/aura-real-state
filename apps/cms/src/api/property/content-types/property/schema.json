{
  "kind": "collectionType",
  "collectionName": "properties",
  "info": {
    "singularName": "property",
    "pluralName": "properties",
    "displayName": "Property",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": { "localized": true }
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "description": {
      "type": "text",
      "required": true,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "amenities": {
      "type": "component",
      "component": "shared.amenity",
      "repeatable": true,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "city": {
      "type": "string",
      "required": true,
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "type": {
      "type": "enumeration",
      "enum": ["house", "villa", "apartment", "penthouse"],
      "required": true,
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "price": {
      "type": "decimal",
      "required": true,
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "beds": {
      "type": "integer",
      "required": true,
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "baths": {
      "type": "integer",
      "required": true,
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "sqm": {
      "type": "decimal",
      "required": true,
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "images": {
      "type": "media",
      "multiple": true,
      "allowedTypes": ["images"],
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "agent": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::agent.agent",
      "inversedBy": "properties"
    }
  }
}
